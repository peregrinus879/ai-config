#!/usr/bin/env bash
# commit-gate - PreToolUse hook: no tool ever creates a commit through Git.
#
# commit-apply is the only path to a commit; it commits the candidate
# commit-candidate recorded and verifies the result, and the hook never sees
# it as a Git command. Raw Git commands H wants run are H's own, through the
# `!` prefix, outside the tools.
#
# The command text is scanned, not parsed, so it fails closed. Quotes,
# backslash continuations, and escapes are normalized away first. Then every
# `git` word, with any path prefix and any global options, followed on the
# same line by a commit-producing subcommand (commit, merge or pull without
# --ff-only, cherry-pick, rebase, revert, am, commit-tree, update-ref,
# replace, filter-branch, stash beyond list and show, notes, fast-import), by
# an alias whose definition contains one of them, by an inline `-c alias.`
# definition, or by a subcommand that is not a literal word, anywhere in the
# text including inside quotes, is denied, and so is any dashed executable
# such as git-commit; every occurrence is checked, not just the first. This
# lexical gate blocks the named command forms, not code hidden in scripts or
# arbitrary shell expansion. commit-apply verifies its own result. A
# false positive costs one rewritten command, or writing prose that mentions
# such a command with the file tools instead of a shell heredoc; a miss would
# cost the gate. The hook reads the JSON the tool sends on stdin (Claude Code
# and Codex send the same shape; the OpenCode plugin mirrors it), prints the
# hookSpecificOutput JSON on stdout, the reason on stderr, and exits 2 to
# deny.
#
# `make stow` installs this file as a real copy under ~/.agents/hooks,
# outside every workspace, and the hooks name that copy: a hook runs outside
# the Codex sandbox, so its executable must not be writable from inside it.
set -euo pipefail

deny() {
  jq -n --arg reason "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
  printf 'commit-gate: %s\n' "$1" >&2
  exit 2
}

input=$(cat)
jq -se 'length == 1 and (.[0] | type == "object")' <<<"$input" >/dev/null 2>&1 || deny 'malformed hook JSON; command protection could not be checked'
if jq -e '.tool_name and (.tool_name | test("^(Bash|bash|shell|shell_command)$") | not)
  and (.tool_input.command == null) and (.tool_input.cmd == null)' <<<"$input" >/dev/null 2>&1; then
  exit 0
fi
command=$(jq -er '
  def valid: type == "string" and length > 0 and (contains("\u0000") | not);
  if .tool_input.command != null and .tool_input.cmd != null and .tool_input.command != .tool_input.cmd
  then error("conflicting commands") else . end |
  (.tool_input.command // .tool_input.cmd) |
  if type == "array" and length > 0 and all(.[]; valid) then join(" ")
  elif valid then .
  else error("invalid shell command") end' <<<"$input" 2>/dev/null) || deny 'malformed Bash input; command protection could not be checked'
cwd=$(jq -er '(.cwd // "") | if type == "string" then . else error("invalid cwd") end' <<<"$input" 2>/dev/null) || deny 'malformed hook cwd'
cwd=${cwd:-$PWD}

# Normalize the shell-token tricks that split, quote, or continue a word:
# quotes of every kind disappear, backslash-newline joins, and any escaped
# character stands for itself. Variables and substitutions cannot be resolved
# here, so a subcommand position that starts one is denied outright below.
text=${command//\\$'\n'/ }
text=$(printf '%s' "$text" | sed -E "s/\\$'/'/g; s/['\"]//g; s/\\\\(.)/\\1/g")

producers='commit-tree|commit|merge|pull|cherry-pick|rebase|revert|am|update-ref|replace|filter-branch|stash|notes|fast-import'
subcommands=$producers
while read -r name value; do
  if [[ $value =~ (^|[^[:alnum:]_-])($producers)([^[:alnum:]_-]|$) ]]; then
    subcommands+="|${name#alias.}"
  fi
done < <(git -C "$cwd" config --get-regexp '^alias\.' 2>/dev/null || git config --get-regexp '^alias\.' 2>/dev/null || true)

reason="commit-apply commits the recorded candidate, and raw Git commands are H's own through the ! prefix"
boundary='(^|[^[:alnum:]_/.-])'
prefix='([^[:space:]]*/)?'
segment="[^;&|)"$'\n'"]*"

# An inline alias definition can name any subcommand; no tool ever needs one.
inline_alias="${boundary}${prefix}git${segment}[[:space:]]-c[[:space:]]*alias\\."
if [[ $text =~ $inline_alias ]]; then
  deny "an inline Git alias is never used by a tool: $reason"
fi

# The dashed executables behind every subcommand, such as git-commit on the exec path.
dashed="${boundary}${prefix}git-(${producers})([^[:alnum:]_-]|$)"
if [[ $text =~ $dashed ]]; then
  deny "git-${BASH_REMATCH[3]} is never run by a tool: $reason"
fi

# A subcommand that is not a literal word (a variable, a substitution, a brace
# expansion) cannot be checked, so it is denied. This check takes option
# arguments as single words, so a later variable such as `git -C $root diff
# --binary $tree` cannot be pulled into the subcommand position by backtracking.
# Global options that take a separate argument, and the bare options that do
# not; the bare form never matches an argument-taking option alone, so its
# argument can never be mistaken for the subcommand.
argopt='(-[Cc]|--git-dir|--work-tree|--namespace|--exec-path|--super-prefix|--config-env)[ \t]+[^[:space:]]+'
bare='-[^-Cc[:space:]][^[:space:]]*|-[Cc][^[:space:]]+|--[^[:space:]=]+=[^[:space:]]*|--(no-pager|paginate|bare|literal-pathspecs|glob-pathspecs|noglob-pathspecs|icase-pathspecs|no-replace-objects|no-optional-locks|no-lazy-fetch|no-advice|version|help)'
single="([ \t]+${argopt}|[ \t]+(${bare}))*"
opaque="${boundary}${prefix}git${single}[ \t]+[\$\`{]"
if [[ $text =~ $opaque ]]; then
  deny "a Git subcommand that is not a literal word is never run by a tool: $reason"
fi

# The producer match lets an option argument span several words, since quotes
# were stripped above; the match backtracks to a literal subcommand.
options="([ \t]+${argopt}([ \t]+[^-[:space:]][^[:space:]]*)*|[ \t]+(${bare}))*"
pattern="${boundary}${prefix}git(${options})[ \t]+(${subcommands})([^[:alnum:]_-]|$)(${segment})"
# Exempt only an unambiguous, literal ff-only operation. Unknown options may
# consume the apparent --ff-only as an argument, or override its semantics.
ff_only() {
  local token seen=0
  local -a tokens
  read -r -a tokens <<<"$1"
  for token in "${tokens[@]}"; do
    case $token in
      --ff-only) seen=1 ;;
      -q|--quiet|-v|--verbose|--progress|--no-progress|--no-rebase|--no-edit|--stat|--no-stat|--prune|--no-tags|--tags) ;;
      -*) return 1 ;;
      *) [[ $token =~ ^[[:alnum:]_./:@+~-]+$ ]] || return 1 ;;
    esac
  done
  (( seen == 1 ))
}
rest=$text
while [[ $rest =~ $pattern ]]; do
  match=${BASH_REMATCH[0]}
  sub=${BASH_REMATCH[9]}
  tail=${BASH_REMATCH[11]}
  if { [[ $sub == merge || $sub == pull ]] && ff_only "$tail"; } ||
     [[ $sub == stash && $tail =~ ^[[:space:]]*(list|show)([[:space:]]|$) ]]; then
    rest=${rest#*"$match"}
    continue
  fi
  deny "git $sub is never run by a tool: $reason"
done
exit 0
