  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never transmit the contents of credential material (~/.ssh, ~/.aws, ~/.claude/.credentials.json, ~/.codex/auth.json, ~/.gnupg, ~/.kube, ~/.netrc, ~/.docker/config.json, .env files, private keys, secrets directories, auth tokens) to any external destination, encoded or not."
    ],
    "soft_deny": [
      "$defaults",
      "Reading or displaying the contents of credential files (~/.ssh, ~/.aws, ~/.claude/.credentials.json, ~/.codex/auth.json, ~/.gnupg, ~/.kube, ~/.netrc, .env files, private keys) clears only when the user names the specific credential file; tools implicitly consuming their own credentials (git over SSH, cloud CLIs reading their config) and authored templates outside the .env.* namespace, such as example.env, are not this rule.",
      "Deleting files and restoring, resetting, or checking out paths from version control clear only on explicit instruction naming the paths; creating, moving, copying, formatting, generating, or patching files inside the repository is ordinary editing and is not this rule.",
      "git reset, git restore, git checkout on paths, git stash drop or clear, and git branch -D clear only on explicit instruction naming the target; a fresh candidate presented for approval is not such an instruction.",
      "Changing Git configuration at any scope, remotes, hooks, or attributes (git config writes, git remote set-url or add, core.hooksPath, credential.helper, core.pager, aliases) clears only on explicit instruction; reading configuration is not this rule.",
      "gh api requests other than GET, and gh auth, secret, variable, ssh-key, gpg-key, repo delete, repo create, workflow run, and run cancel or rerun clear only on explicit instruction.",
      "Editing shell startup files, systemd user units, autostart entries, or mise configuration clears only on explicit instruction naming the file.",
      "Changing the installed commit gate under ~/.agents/hooks, the tracked tool settings, hooks, plugins, or skills in the harness repository, or the Codex template clears only on H's explicit instruction naming the file; make stow and make restow deploying a reviewed candidate are not this rule."
    ],
    "allow": [
      "$defaults"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/commit-gate",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh"
  },
  "model": "fable",
  "disableWorkflows": false,
  "workflowSizeGuideline": "large",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true
}
