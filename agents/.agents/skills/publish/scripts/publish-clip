#!/usr/bin/env bash
# publish-clip --copy - copy a reviewed command only after H requests it.
#
# Without --copy, leave both stdin and the clipboard untouched. With --copy,
# read command text on stdin (without trailing newlines) and try, in order,
# wl-copy under Wayland (Omarchy), clip.exe through Windows interop (WSL), then
# xclip or xsel under X11. Report this attempt, not the clipboard's later state.
# --copy is an explicit CLI action, not independent proof of a human selection;
# the publish skill requires H's Copy push command choice before invoking it.
set -euo pipefail

if (($# == 0)); then
  printf 'clipboard: unchanged (copy not requested)\n'
  exit 0
fi
if [[ $# != 1 || $1 != --copy ]]; then
  printf 'usage: publish-clip --copy < reviewed-command-file\n' >&2
  exit 64
fi

text=$(cat)
if [[ -z $text ]]; then
  printf 'clipboard: none (empty input)\n'
  exit 0
fi

try() { # tool [args...]
  local tool=$1
  shift
  command -v -- "$tool" >/dev/null 2>&1 || return 1
  printf '%s' "$text" | timeout --kill-after=2 5 "$tool" "$@" >/dev/null 2>&1 || return 1
  printf 'clipboard: %s\n' "$tool"
}

if [[ -n ${WAYLAND_DISPLAY:-} ]] && try wl-copy; then exit 0; fi
if try clip.exe; then exit 0; fi
if [[ -n ${DISPLAY:-} ]] && { try xclip -selection clipboard || try xsel --clipboard --input; }; then exit 0; fi
printf 'clipboard: none\n'
