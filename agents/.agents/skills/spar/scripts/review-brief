#!/usr/bin/env bash
# review-brief - scanned, local evidence, never a persistent gate cache.
# Usage: review-brief --intent FILE --out NEW_FILE
#        [--staged | --worktree | --range BASE..TIP | --plan]
#        [--gate LITERAL_MAKE_TARGET]... [--no-gates]
# Plan mode never runs gates. Repository output is limited to new ignored,
# untracked .eyr-plans/<workstream>/{audit,spar}/*.md files in owned private
# directories; governance is reserved. No directories are created. External
# artifacts require the caller's private TMPDIR accepted by spar-payload-scan.
# Fingerprints are read-only observations, not Git trees or runtime attestations.
# Plan mode observes HEAD/index only, never source contents. Change modes stream
# safe source hashes without artifact-size limits; sensitive source paths refuse.
# Exit: 0 artifact written (may be explicitly unverified), 1 diagnostic artifact
# retained for failed gates/source drift, 2 scanner/path refusal (no new artifact),
# 3 repository/IO refusal, 64 usage/conflicts or existing output. No Git writes.
set -euo pipefail
exec /usr/bin/python3 -I - "$(realpath -e -- "${BASH_SOURCE[0]}")" "$@" <<'PY'
import argparse
import hashlib
import json
import os
import re
import runpy
import shlex
import stat
import subprocess
import sys
from datetime import datetime, timezone

scanner_path = os.path.join(os.path.dirname(sys.argv[1]), "spar-payload-scan")
scan = runpy.run_path(scanner_path)


def fail(message, code=3):
    print("review-brief: " + message, file=sys.stderr)
    raise SystemExit(code)


def git(*arguments):
    result = subprocess.run(
        ["git", "--no-pager", *arguments], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
    )
    if result.returncode:
        fail("read-only Git query failed; repository/ref state refused")
    return result.stdout


def digest(data):
    return hashlib.sha256(data).hexdigest()


def main():
    parser = argparse.ArgumentParser(description="Assemble scanned review evidence", allow_abbrev=False)
    parser.error = lambda message: fail(message, 64)
    parser.add_argument("--intent", required=True)
    parser.add_argument("--out", required=True)
    modes = parser.add_mutually_exclusive_group()
    for mode in ("staged", "worktree", "plan"):
        modes.add_argument("--" + mode, action="store_true")
    modes.add_argument("--range")
    parser.add_argument("--gate", action="append", default=[])
    parser.add_argument("--no-gates", action="store_true")
    args = parser.parse_args(sys.argv[2:])
    if args.gate and (args.no_gates or args.plan):
        fail("--gate conflicts with --no-gates and --plan", 64)
    if any(not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_./-]*", target) for target in args.gate):
        fail("--gate requires a literal make target, not an option or assignment", 64)
    intent, out = os.path.abspath(args.intent), os.path.abspath(args.out)
    out_lexical = out
    root = os.fsdecode(git("rev-parse", "--show-toplevel")).rstrip("\n")
    root = os.path.realpath(root)
    os.chdir(root)
    scratch = os.path.realpath(os.environ["TMPDIR"]) if os.environ.get("TMPDIR") else None
    scan_args = [scanner_path, "outbound", "--root", root]
    if scratch:
        scan_args += ["--scratch-root", scratch]
    # Let the scanner validate caller scratch, including ownership and permissions.
    if subprocess.run(scan_args + ["--"], input=b"Review evidence.", stdout=subprocess.DEVNULL).returncode:
        fail("scanner refused artifact roots", 2)

    def path_preflight(path):
        # The scanner's existing confinement API requires an existing leaf. This
        # equivalent name-only check also handles deleted source and new output.
        lexical, resolved = os.path.abspath(path), os.path.realpath(path)
        for candidate in (lexical, resolved):
            if ".git" in candidate.split("/") or scan["sensitive_path"](candidate):
                fail("sensitive or Git-internal path refused before content access", 2)
            if re.match(r"^/(?:var/)?tmp/(?:opencode|claude-[^/]+|codex[^/]*)/", candidate):
                if not scratch or not candidate.startswith(scratch + "/"):
                    fail("path is outside private caller scratch", 2)
        if not any(resolved.startswith(base + "/") for base in (root, scratch) if base):
            fail("path must live under the repository or private caller TMPDIR", 2)
        return resolved

    path_preflight(intent)
    out = path_preflight(out)
    in_repo = out.startswith(root + "/")
    plan_directories = {}

    def plan_output_preflight():
        if not args.plan or not (in_repo or out_lexical.startswith(root + "/")):
            return
        relative = os.path.relpath(out_lexical, root)
        match = re.fullmatch(r"\.eyr-plans/([A-Za-z0-9][A-Za-z0-9_-]*)/(audit|spar)/[^/]+\.md", relative)
        if not match or match[1] == "governance":
            fail("--plan repository output requires .eyr-plans/<workstream>/{audit,spar}/<file>.md; governance is reserved", 64)
        if "GIT_INDEX_FILE" in os.environ:
            fail("--plan repository output requires the repository's normal index", 64)
        if out_lexical != out or os.path.realpath(out_lexical) != out_lexical:
            fail("--plan repository output cannot use symlink aliases or parents", 2)
        namespace = os.path.join(root, ".eyr-plans")
        workstream = os.path.join(namespace, match[1])
        plan_directories.update({namespace: 0o022, workstream: 0o077, os.path.dirname(out): 0o077})
        for directory, forbidden in plan_directories.items():
            try:
                metadata = os.lstat(directory)
            except OSError:
                fail("--plan artifact directories must already exist and be accessible", 2)
            if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid()
                    or metadata.st_mode & forbidden
                    or (directory != namespace and stat.S_IMODE(metadata.st_mode) != 0o700)):
                fail("--plan artifact directories must be real, owned and private (top .eyr-plans may be 0755)", 2)
        if git("--literal-pathspecs", "ls-files", "--cached", "-z", "--", relative):
            fail("--plan repository output must not be tracked", 64)
        ignored = subprocess.run(
            ["git", "check-ignore", "--quiet", "--no-index", "--", relative],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
        ).returncode
        if ignored == 1:
            fail("--plan repository output must already be ignored by Git", 64)
        if ignored:
            fail("read-only Git ignore query failed")

    plan_output_preflight()
    if os.path.lexists(out) or os.path.lexists(out_lexical):
        fail("output exists; written as a new file only", 64)
    out_dir = os.path.dirname(out)
    if not os.path.isdir(out_dir):
        fail("output directory missing", 2)
    canonical = scan["confine_artifact"](intent, [root], "intent", scratch)
    intent_bytes = scan["read_artifact"](canonical, "intent")
    intent_text = scan["decode_text"]("intent", intent_bytes)
    scan["enforce"](scan["content_findings"]("intent", intent_text, True))
    missing = [field for field in ("Outcome", "Non-goals", "Constraints", "Acceptance")
               if not re.search("^" + field + ":", intent_text, re.M)]
    if missing:
        fail("the intent lacks a line starting with: " + " ".join(missing), 64)

    def source_state():
        head = git("rev-parse", "--verify", "HEAD^{commit}").decode().strip()
        entries = git("ls-files", "--stage", "-z")
        flags = git("ls-files", "-v", "-z")
        # Raw cached scope distinguishes intent-to-add without reading worktree bytes.
        scope = git("diff", "--cached", "--raw", "--no-renames", "--no-ext-diff", "--no-textconv", "-z", head)
        state = {
            "HEAD": head,
            "index entries SHA-256": digest(entries + b"\0flags\0" + flags + b"\0scope\0" + scope),
        }
        if args.plan:
            state["worktree observation"] = "not collected (--plan; no source-content reads)"
            return state
        tracked = set(git("ls-files", "--cached", "-z").split(b"\0")[:-1])
        tracked.update(git("ls-tree", "-r", "--name-only", "-z", head).split(b"\0")[:-1])
        names = sorted(tracked)
        for name in names:
            path_preflight(os.fsdecode(name))
        manifest, unsupported = [], 0
        for name in names:
            path = os.fsdecode(name)
            resolved = path_preflight(path)
            if not os.path.lexists(path):
                item = [path, "missing"]
            elif os.path.islink(path):
                item = [path, "symlink", os.readlink(path)]
                unsupported += 1  # Link targets are not recursively attested.
            elif os.path.isdir(path):
                item = [path, "directory/gitlink"]
                unsupported += 1
            else:
                # Match scanner file safety, not its outbound artifact byte cap.
                # Hash raw source in fixed-size chunks, including binary assets.
                try:
                    if not stat.S_ISREG(os.lstat(resolved).st_mode):
                        fail("tracked source is not a regular file", 2)
                    descriptor = os.open(resolved, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOFOLLOW)
                except OSError:
                    fail("cannot open tracked source without following links", 2)
                with os.fdopen(descriptor, "rb") as stream:
                    metadata = os.fstat(stream.fileno())
                    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_nlink != 1:
                        fail("tracked source is not a single-link regular file owned by the current user", 2)
                    source_hash = hashlib.sha256()
                    while chunk := stream.read(128 * 1024):
                        source_hash.update(chunk)
                item = [path, stat.S_IMODE(metadata.st_mode), source_hash.hexdigest()]
                unsupported += os.path.abspath(path) != resolved
            manifest.append(item)
        untracked = git("ls-files", "--others", "--exclude-standard", "-z")
        state.update({
            "tracked worktree SHA-256": digest(json.dumps(manifest, ensure_ascii=True).encode()),
            "untracked names SHA-256 (not contents)": digest(untracked),
            "untracked count": untracked.count(b"\0"),
            "unattested symlink/gitlink count": unsupported,
        })
        state["source-state SHA-256"] = digest(json.dumps(state, sort_keys=True).encode())
        return state

    before = source_state()
    head_line = git("log", "-1", "--format=%H %s").decode().strip()
    branch = git("rev-parse", "--abbrev-ref", "HEAD").decode().strip()
    mode = "plan" if args.plan else "range" if args.range else "worktree" if args.worktree else "staged"
    log, diff, change_stat = "", b"", b""
    if args.range:
        if not re.fullmatch(r"[^.\s-][^\s]*\.\.[^.\s-][^\s]*", args.range) or "..." in args.range:
            fail("--range takes BASE..TIP", 64)
        base, tip = [git("rev-parse", "--verify", "--end-of-options", ref + "^{commit}").decode().strip()
                     for ref in args.range.split("..", 1)]
        git("merge-base", "--is-ancestor", base, tip)
        for ref in (base, tip):
            for name in git("ls-tree", "-r", "--name-only", "-z", ref).split(b"\0")[:-1]:
                path_preflight(os.fsdecode(name))
        log = git("log", "--format=%H %s", base + ".." + tip).decode()
        if not log:
            fail("no commits in range")
        compare = [base, tip]
        title = "commits " + args.range
    elif mode == "staged":
        compare, title = ["--cached", before["HEAD"]], "staged index against HEAD"
    elif mode == "worktree":
        compare, title = [before["HEAD"]], "working tree against HEAD"
    else:
        compare, title = [], "none, plan review"
    if mode != "plan":
        options = ["diff", "--no-ext-diff", "--no-textconv", "--no-color", "--ignore-submodules=dirty", "--submodule=short"]
        diff = git(*options, *compare, "--")
        change_stat = git(*options, "--stat", *compare, "--")
        if not diff:
            fail("nothing is staged" if mode == "staged" else "no tracked diff to review")
        scan["enforce"](scan["content_findings"]("diff", scan["decode_text"]("diff", diff), True))

    gates, failed = [], False
    skipped = args.no_gates or args.plan
    if skipped:
        gates.append("- gates: unverified, skipped by " + ("--no-gates" if args.no_gates else "--plan (read-only)"))
    else:
        for target in args.gate or ["lint", "check"]:
            command = ["make", "--no-print-directory", "-C", root, "--", target]
            result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            failed |= result.returncode != 0
            gates += ["- command: `" + shlex.join(command) + "`",
                      f"- {target}: {'ok' if result.returncode == 0 else 'FAIL'} (make exit {result.returncode})"]
            if result.returncode:
                output = scan["decode_text"]("gate output", result.stdout)
                scan["enforce"](scan["content_findings"]("gate output", output, True))
                gates.append("Last 20 output lines:\n```\n" + "\n".join(output.splitlines()[-20:]) + "\n```")
    after = source_state()
    changed = before != after
    reasons = []
    if skipped:
        reasons.append("gates unverified/skipped; --no-gates alone is never gate evidence")
    if failed:
        reasons.append("failed gates")
    if changed:
        reasons.append("repository metadata changed during plan collection" if args.plan else "source-state changed during collection/gates")
    if before.get("untracked count", 0) or after.get("untracked count", 0):
        reasons.append("Git-visible untracked contents were not read or hashed")
    if before.get("unattested symlink/gitlink count", 0) or after.get("unattested symlink/gitlink count", 0):
        reasons.append("symlink targets or gitlink contents are not attested")
    if in_repo:
        reasons.append("output creates a repository file after these observations")
    reuse = "disabled: " + "; ".join(reasons) if reasons else "conditional evidence only, not automatic reuse"
    state_text = "\n".join(f"- {key}: {value}" for key, value in before.items())
    after_text = "\n".join(f"- {key}: {value}" for key, value in after.items())
    comparison = "repository metadata" if args.plan else "source-state"
    scope = (
        "Plan observation scope: HEAD and read-only index entries/flags only. Worktree contents, "
        "untracked names/contents and symlink/gitlink contents were not collected. No source-state "
        "or worktree digest is asserted, and no gate evidence or reuse is available."
        if args.plan else
        "Fingerprint scope: SHA-256 of read-only index entries/flags and streamed raw tracked file bytes/modes, "
        "missing paths and link names. Untracked names/counts are recorded, NOT their contents; "
        "tracked equality never covers untracked inputs. Sensitive tracked source paths refuse before reads, "
        "even if apparently unchanged; this brief does not infer their content equality."
    )
    body = (
        f"# Review brief\n\nAssembled {datetime.now(timezone.utc).isoformat()} in {root}, branch {branch}.\n\n"
        f"## Intent\n\n{intent_text}\n\n## Repository state\n\n- head: {head_line}\n"
        f"- mode: {mode}\n\n### Before {'collection' if args.plan else 'gates'}\n\n{state_text}\n\n"
        f"### After {'collection' if args.plan else 'gates'}\n\n{after_text}\n\n"
        f"- {comparison} comparison: {'CHANGED' if changed else 'observed fingerprints unchanged'}\n"
        f"- reuse: {reuse}\n\n"
        f"{scope} These are not Git tree IDs; no staging or write-tree is performed. "
        "Ignored files, dependencies, runtime/environment, Git configuration and host inputs are not attested. "
        "Their relevant state must be supplied and revalidated in the intent/checkpoint, never inferred.\n\n"
        "Same-workstream reuse requires re-reading this artifact, exact unchanged relevant source state "
        "and revalidated context. Unknown changes forbid reuse. Endpoint observations cannot detect "
        "transient changes reverted between observations and are not a concurrency lock. "
        "A candidate tree may be supplied in intent and verified separately; this brief does not verify it.\n\n"
        "## Gates\n\n"
        + ("" if args.plan else
           "- execution scope when run: working checkout, not an attestation of the index or range tip. "
           "The diff below was collected before gates; different trees do not share gate evidence.\n")
        + "\n".join(gates) + f"\n\n## Change: {title}\n\n"
    )
    if mode == "plan":
        body += "The plan is the intent above; no diff was collected and no gates were executed.\n"
    else:
        if log:
            body += "Commits:\n```\n" + log + "```\n\n"
        body += "Stat:\n```\n" + change_stat.decode() + "```\n\n```diff\n" + diff.decode() + "```\n"
    data = body.encode()
    if len(data) > scan["ARTIFACT_MAX"]:
        fail("brief exceeds scanner artifact limit", 2)
    scan["enforce"](scan["content_findings"]("brief", body, True))
    # Pin the parent and exclusively create only after the complete scan. A
    # raced file/link is never replaced, and no unscanned draft touches disk.
    path_preflight(out)
    plan_output_preflight()
    directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        parent_path = ""
        for component in out_dir.strip("/").split("/"):
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = child
            parent_path += "/" + component
            if parent_path == scratch:
                metadata = os.fstat(directory)
                if metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
                    raise OSError("scratch is no longer private")
            if parent_path in plan_directories:
                metadata = os.fstat(directory)
                forbidden = plan_directories[parent_path]
                if (metadata.st_uid != os.getuid() or metadata.st_mode & forbidden
                        or (forbidden == 0o077 and stat.S_IMODE(metadata.st_mode) != 0o700)):
                    raise OSError("plan artifact directory is no longer owned/private")
    except OSError:
        os.close(directory)
        fail("output parent changed or cannot be opened without links", 2)
    try:
        descriptor = os.open(os.path.basename(out), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                             0o600, dir_fd=directory)
        created = os.fstat(descriptor)
        try:
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(data)
        except BaseException:
            current = os.stat(os.path.basename(out), dir_fd=directory, follow_symlinks=False)
            if (current.st_dev, current.st_ino) == (created.st_dev, created.st_ino):
                os.unlink(os.path.basename(out), dir_fd=directory)
            raise
    except FileExistsError:
        fail("output exists; written as a new file only", 64)
    finally:
        os.close(directory)
    print(f"brief: {out} ({len(data)} bytes; change: {title})")
    return 1 if failed or changed else 0


try:
    sys.exit(main())
except (OSError, UnicodeError, ValueError):
    fail("IO, encoding or repository state refused; no diagnostic bytes exposed")
PY
