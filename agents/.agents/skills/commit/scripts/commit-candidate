#!/usr/bin/env bash
# Record the prepared index; --stage explicitly stages whole intended paths.
# Usage: commit-candidate [--stage] [--message-file FILE] -- PATH...
#        commit-candidate --show ID | --clear ID
set -euo pipefail
exec python3 -I "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")/governance.py" candidate "$@"
