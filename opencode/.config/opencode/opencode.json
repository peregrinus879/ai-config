{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.4-mini",
  "enabled_providers": [
    "openai"
  ],
  "skills": {
    "paths": [
      "~/.agents/skills"
    ]
  },
  "agent": {
    "auditor": {
      "description": "Read-only audit of a plan, diff, or decision from a fresh context; the spar loop without the second vendor. Never edits.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "prompt": "{file:~/.agents/agents/auditor.md}",
      "permission": {
        "*": {},
        "read": {},
        "glob": {},
        "external_directory": {},
        "**": "deny"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "claude *": "deny",
      "claude --version": "allow",
      "codex *": "deny",
      "codex --version": "allow",
      "opencode *": "deny",
      "opencode --version": "allow",
      "doas": "deny",
      "doas *": "deny",
      "gh api *": "deny",
      "gh auth *": "deny",
      "gh gist create*": "deny",
      "gh gist delete*": "deny",
      "gh gist edit*": "deny",
      "gh gpg-key *": "deny",
      "gh issue close*": "deny",
      "gh issue comment*": "deny",
      "gh issue create*": "deny",
      "gh issue edit*": "deny",
      "gh issue reopen*": "deny",
      "gh pr close*": "deny",
      "gh pr create*": "deny",
      "gh pr merge*": "deny",
      "gh release create*": "deny",
      "gh release delete*": "deny",
      "gh release edit*": "deny",
      "gh release upload*": "deny",
      "gh repo create*": "deny",
      "gh repo delete*": "deny",
      "gh run cancel*": "deny",
      "gh run rerun*": "deny",
      "gh secret *": "deny",
      "gh ssh-key *": "deny",
      "gh variable *": "deny",
      "gh workflow run*": "deny",
      "git branch -D *": "ask",
      "git branch -d *": "ask",
      "git checkout -- *": "ask",
      "git clean": "deny",
      "git clean *": "deny",
      "git config --global *": "ask",
      "git config --system *": "ask",
      "git config alias*": "ask",
      "git config core.hooksPath*": "ask",
      "git config core.pager*": "ask",
      "git config credential*": "ask",
      "git push": "deny",
      "git push *": "deny",
      "git remote add *": "ask",
      "git remote remove *": "ask",
      "git remote set-url *": "ask",
      "git reset": "ask",
      "git reset *": "ask",
      "git restore": "ask",
      "git restore *": "ask",
      "git stash clear": "ask",
      "git stash clear *": "ask",
      "git stash drop": "ask",
      "git stash drop *": "ask",
      "pkexec": "deny",
      "pkexec *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "ssh *": "deny",
      "su": "deny",
      "su *": "deny",
      "sudo": "deny",
      "sudo *": "deny"
    },
    "edit": {
      "*": "allow",
      "../*": "ask",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pem": "deny",
      "**/*.pfx": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.git/**": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/auth.json": "deny",
      "**/credentials": "deny",
      "**/credentials.*": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_rsa": "deny",
      "**/secrets/**": "deny",
      ".env": "deny",
